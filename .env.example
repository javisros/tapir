# Copy to .env and fill in. Only needed for the LLM generator and the literature check;
# tests, benchmarks A/B, the atlas and the app run without it.

# LLM (OpenAI-compatible endpoint, e.g. a LiteLLM proxy) - tapir/llm_client.py
LITELLM_BASE_URL=
LITELLM_API_KEY=
TAPIR_LLM_MODEL=
TAPIR_LLM_MAX_CALLS=
TAPIR_LLM_REASONING_EFFORT=

# Valency MCP Bond (literature search) - tapir/literature.py
BOND_MCP_URL=
BOND_TOKEN=
BOND_SEARCH_TOOL=
